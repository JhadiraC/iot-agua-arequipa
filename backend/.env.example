# Backend configuration template (copy to .env for local use; NEVER commit .env)
STORAGE_MODE=local
LOCAL_DB_PATH=local_dev.db
IOT_API_KEY=replace-with-local-dev-key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8080
# Optional when STORAGE_MODE=firestore outside Cloud Run:
# FIRESTORE_PROJECT_ID=your-gcp-project-id
